            "properties": {
              "continue_on_failure": true,
              "description": "Uses the supplied replacement selector or validates and preserves the current WorkloadDefinitionReference mapper.",
              "display_name": "Derive selected definition mapper",
              "skip_execution": false,
              "action_timeout": 180,
              "script": "import json\nimport sys\nstatus = 'invalid'\nfailureCode = '502'\nfailureMessage = 'Definition selector was invalid'\nfailureError = 'The selected definition mapper could not be derived.'\nfailureResult = '{}'\ntry:\n    deployment = json.loads(sys.argv[1])\n    requested = sys.argv[5]\n    requestedPreferred = sys.argv[6] == 'true'\n    requestedVersion = int(sys.argv[4])\n    mapper = deployment.get('WorkloadDefinitionReference')\n    if not isinstance(mapper, dict):\n        raise ValueError('Current WorkloadDefinitionReference is missing.')\n    if requested:\n        selectedDefinitionName = requested\n        usePreferred = requestedPreferred\n        selectedVersion = requestedVersion\n    else:\n        selectedDefinitionName = str(mapper.get('DefinitionName', '')).strip()\n        usePreferred = mapper.get('UsePreferredVersion') is True\n        selectedVersion = int(mapper.get('Version', 0) or 0)\n    if not selectedDefinitionName:\n        raise ValueError('Selected definition name is empty.')\n    if not usePreferred and selectedVersion < 1:\n        raise ValueError('Selected non-preferred definition version is invalid.')\n    selectedUsePreferred = 'true' if usePreferred else 'false'\n    selectedDefinitionVersion = str(selectedVersion)\n    escapedSelectedDefinitionName = selectedDefinitionName.replace(\"'\", \"''\")\n    definitionClause = 'PreferredVersion eq true' if usePreferred else 'Version eq ' + str(selectedVersion)\n    status = 'ready'\n    failureCode = failureMessage = failureError = ''\n    failureResult = '{}'\nexcept Exception as exc:\n    selectedDefinitionName = selectedUsePreferred = selectedDefinitionVersion = escapedSelectedDefinitionName = definitionClause = ''\n    failureError = 'Definition selector failed closed: ' + str(exc)\n    failureResult = json.dumps({'error': failureMessage, 'details': failureError}, separators=(',', ':'))\n",
              "script_arguments": [
                "$workflow.definition_workflow_02Z3AAXNVAM5J0mc6ZWuVho9QDMWxIjXLkG.input.variable_workflow_02Z3AAXNVAM5J07dAuOndHcKxQT4fQA393H$",
