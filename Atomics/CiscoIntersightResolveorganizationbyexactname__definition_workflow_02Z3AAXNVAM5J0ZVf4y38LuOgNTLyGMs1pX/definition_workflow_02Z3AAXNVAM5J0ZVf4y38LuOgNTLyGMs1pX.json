          "skip_execution": false,
          "action_timeout": 180,
          "script": "import json\nimport re\nimport sys\n\n# HTTP evidence is independent from strict organization identity inspection.\n# The connector contract supplies an integral HTTP status and Boolean success.\ntry:\n    httpStatus = int(sys.argv[4])\nexcept (ValueError, TypeError):\n    httpStatus = 0\nrequestSucceeded = sys.argv[5].strip().lower() == \"true\"\nif not requestSucceeded or httpStatus != 200:\n    statusCode = httpStatus if 300 <= httpStatus < 600 else 502\n    lookupStatus = \"api-failure\"\n    message = \"Organization lookup API request failed\"\n    errorMessage = \"The organization request failed or returned a non-200 response.\"\n    organizationMoid, organizationJson, inspectionComplete = \"\", \"{}\", False\n    safeCode, safeMessage = \"\", \"\"\n    try:\n        payload = json.loads(sys.argv[1])\n        # Preserve the native String projection used by the old safe allowlists.\n        def text(value):\n            return value if isinstance(value, str) else json.dumps(value, separators=(\",\", \":\"), ensure_ascii=False)\n        code = text(payload[\"Code\"]) if isinstance(payload, dict) and \"Code\" in payload else \"\"\n        detail = text(payload[\"Message\"]) if isinstance(payload, dict) and \"Message\" in payload else \"\"\n        if re.fullmatch(r\"[A-Za-z0-9_.:-]{1,128}\", code):\n            safeCode = code\n        if re.fullmatch(r\"[A-Za-z0-9 _.,:()/+\\-]{1,500}\", detail) and not re.search(r\"authorization|password|secret|token|api.?key|bearer|https?://\", detail, re.IGNORECASE):\n            safeMessage = detail\n    except Exception:\n        pass\n    if safeMessage:\n        errorMessage = safeMessage\n    resultJson = json.dumps({\"status\":\"api-failure\", \"upstreamStatus\":httpStatus, \"Code\":safeCode, \"Message\":safeMessage}, separators=(\",\", \":\"))\nelse:\n    import json\n    import re\n    import sys\n    statusCode, lookupStatus, message = 502, \"invalid-response\", \"Organization response is invalid\"\n    organizationMoid, organizationJson = \"\", \"{}\"\n    inspectionComplete = False\n    try:\n        payload = json.loads(sys.argv[1])\n        if not isinstance(payload, dict): raise ValueError(\"Organization response must be an object\")\n        count, rows = payload.get(\"Count\"), payload.get(\"Results\")\n        if isinstance(count, bool) or not isinstance(count, int) or count < 0: raise ValueError(\"Count must be a nonnegative integer\")\n        if not isinstance(rows, list): raise ValueError(\"Results must be an array\")\n        if count != len(rows): raise ValueError(\"Count and Results length differ; the bounded page is incomplete\")\n        if count > 2: raise ValueError(\"Count exceeds the two-row lookup bound\")\n        if count == 0: statusCode, lookupStatus, message = 404, \"not-found\", \"No organization matched the exact requested name\"\n        elif count != 1: statusCode, lookupStatus, message = 409, \"ambiguous\", \"More than one organization matched the exact requested name\"\n        else:\n            item = rows[0]\n            if not isinstance(item, dict) or item.get(\"Name\") != sys.argv[2]: raise ValueError(\"Organization Name does not match exactly\")\n            if item.get(\"ObjectType\") != \"organization.Organization\" or item.get(\"ClassId\") != \"organization.Organization\": raise ValueError(\"Organization discriminators do not match\")\n            moid = item.get(\"Moid\")\n            pattern = r\"[0-9a-fA-F]{24}\" if sys.argv[3] == \"Hex24\" else r\"[A-Za-z0-9][A-Za-z0-9._~-]{0,127}\"\n            if not isinstance(moid, str) or re.fullmatch(pattern, moid) is None: raise ValueError(\"Organization Moid is missing or malformed\")\n            organizationMoid = moid\n            projected = {key:item[key] for key in (\"Moid\", \"Name\", \"ObjectType\", \"ClassId\")}\n            organizationJson = json.dumps(projected, separators=(\",\", \":\"))\n            resultJson = json.dumps({\"Count\":1,\"Results\":[projected]}, separators=(\",\", \":\"))\n            statusCode, lookupStatus, message = 200, \"exact\", \"Organization resolved exactly\"\n        inspectionComplete = True\n    except Exception as exc:\n        statusCode, lookupStatus, message, inspectionComplete = 502, \"invalid-response\", str(exc), True\n    errorMessage = \"\" if statusCode == 200 else message\n    if statusCode != 200: resultJson = json.dumps({\"status\":lookupStatus,\"error\":message}, separators=(\",\", \":\"))\n",
          "script_arguments": [
            "$activity.definition_activity_02Z3AAXNVAM5J0kZDGb82tWI8Kjej9pBrW9.output.response_body$",
            "$workflow.definition_workflow_02Z3AAXNVAM5J0ZVf4y38LuOgNTLyGMs1pX.input.variable_workflow_02Z3AAXNVAM5J0Rg63o2jdiD7U14oJN8IUm$",
