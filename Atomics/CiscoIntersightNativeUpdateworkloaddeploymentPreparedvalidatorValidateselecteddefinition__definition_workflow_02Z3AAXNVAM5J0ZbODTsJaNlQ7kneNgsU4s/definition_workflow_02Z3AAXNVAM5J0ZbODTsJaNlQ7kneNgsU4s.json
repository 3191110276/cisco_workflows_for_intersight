            "unique_name": "definition_activity_02Z3AAXNVAM5J0mUiymASEi4oT1EoijWrer",
            "name": "Execute Python Script",
            "title": "Validate selected definition",
            "type": "python3.script",
            "base_type": "activity",
            "properties": {
              "continue_on_failure": false,
              "description": "Requires one exact valid definition, refusing ambiguous preferred versions.",
              "display_name": "Validate selected definition",
              "skip_execution": false,
              "action_timeout": 180,
              "script": "import json\nimport re\nimport sys\nstatus = 'invalid'\nfailureCode = '502'\nfailureMessage = 'Workload definition response was invalid'\nfailureError = 'The selected definition could not be validated.'\nfailureResult = '{}'\ndefinitionMoid = ''\ndefinitionJson = ''\nexpectedName = sys.argv[1]\norganizationMoid = sys.argv[2]\nusePreferred = sys.argv[7] == 'true'\nexpectedVersion = int(sys.argv[4])\nmoidPattern = re.compile('^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$')\ntry:\n    envelope = json.loads(sys.argv[5])\n    results = envelope.get('Results') if isinstance(envelope, dict) else None\n    if not isinstance(results, list):\n        raise ValueError('Results is not an array.')\n    if len(results) == 0:\n        failureCode = '404'\n        failureMessage = 'Workload definition was not found'\n        failureError = 'The exact name/version selection returned zero matches.'\n        failureResult = json.dumps({'error': failureMessage, 'matchCount': 0}, separators=(',', ':'))\n    elif len(results) != 1:\n        failureCode = '409'\n        failureMessage = 'Definition version selection was ambiguous'\n        failureError = 'The exact definition selector returned ' + str(len(results)) + ' matches; exactly one is required. Multiple preferred versions are refused.'\n        failureResult = json.dumps({'error': failureMessage, 'matchCount': len(results)}, separators=(',', ':'))\n    else:\n        item = results[0]\n        if not isinstance(item, dict) or item.get('ClassId') != 'workload.WorkloadDefinition' or item.get('ObjectType') != 'workload.WorkloadDefinition':\n            raise ValueError('The selected result is not a concrete WorkloadDefinition.')\n        definitionMoid = str(item.get('Moid', '')).strip()\n        if not moidPattern.fullmatch(definitionMoid) or str(item.get('Name', '')).strip() != expectedName:\n            raise ValueError('Definition identity does not match.')\n        organization = item.get('Organization')\n        if not isinstance(organization, dict) or str(organization.get('Moid', '')).strip() != organizationMoid or str(organization.get('ObjectType', '')).strip() != 'organization.Organization':\n            raise ValueError('Definition Organization relationship does not match.')\n        if usePreferred and item.get('PreferredVersion') is not True:\n            raise ValueError('The selected definition is not marked PreferredVersion.')\n        if not usePreferred and item.get('Version') != expectedVersion:\n            raise ValueError('The selected definition Version does not match.')\n        validation = item.get('ValidationInformation')\n        if not isinstance(validation, dict) or validation.get('State') != 'Valid':\n            failureCode = '422'\n            failureMessage = 'Workload definition is not valid'\n            failureError = 'The selected definition ValidationInformation.State is not Valid.'\n            failureResult = json.dumps({'error': failureMessage, 'ValidationInformation': validation}, separators=(',', ':'))\n        else:\n            definitionJson = json.dumps(item, separators=(',', ':'), ensure_ascii=False, allow_nan=False)\n            status = 'ready'\n            failureCode = failureMessage = failureError = ''\n            failureResult = '{}'\nexcept Exception as exc:\n    if failureCode == '502':\n        failureError = 'The definition response failed validation: ' + str(exc)\n        failureResult = json.dumps({'error': failureMessage, 'details': failureError}, separators=(',', ':'))\n",
