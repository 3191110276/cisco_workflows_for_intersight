    "actions": [
      {
        "unique_name": "definition_activity_02Z3AAXNVAM5J0FFqkeIpPrlWubKow6KMyS",
        "name": "Execute Python Script",
        "title": "Inspect uncoerced JSON fields and representations",
        "type": "python3.script",
        "base_type": "activity",
        "properties": {
          "continue_on_failure": false,
          "description": "Inspect uncoerced JSON fields and representations",
          "display_name": "Inspect uncoerced JSON fields and representations",
          "skip_execution": false,
          "action_timeout": 180,
          "script": "import json, sys\n\ndef kind(value):\n    if value is None: return \"null\"\n    if isinstance(value, bool): return \"boolean\"\n    if isinstance(value, str): return \"string\"\n    if isinstance(value, dict): return \"object\"\n    if isinstance(value, list): return \"array\"\n    if isinstance(value, int): return \"integer\"\n    return \"number\"\n\ndef serialized(value, ascii_only):\n    try:\n        return json.dumps(value, separators=(\",\", \":\"), ensure_ascii=ascii_only), \"\"\n    except Exception as exc:\n        return \"\", str(exc)\n\nfacts = {\"jsonValid\":False,\"documentKind\":\"invalid\",\"error\":\"\",\"errorType\":\"\",\"objectGetError\":\"\",\"compactJson\":\"\",\"asciiJson\":\"\",\"serializeError\":\"\",\"fields\":{}}\nconfig = json.loads(sys.argv[2])\nfor key in config:\n    facts[\"fields\"][key] = {\"present\":False,\"kind\":\"missing\",\"text\":\"\",\"pythonText\":\"None\",\"pythonTextError\":\"\",\"json\":\"null\",\"asciiJson\":\"null\",\"serializeError\":\"\",\"isTrue\":False,\"isFalse\":False,\"truthy\":False,\"objectGetError\":\"\"}\ntry:\n    payload = json.loads(sys.argv[1])\n    facts[\"jsonValid\"], facts[\"documentKind\"] = True, kind(payload)\n    if not isinstance(payload, dict):\n        try: payload.get(\"_inspection\")\n        except Exception as exc: facts[\"objectGetError\"] = str(exc)\n    facts[\"compactJson\"], facts[\"serializeError\"] = serialized(payload, False)\n    facts[\"asciiJson\"], _ = serialized(payload, True)\n    for key, path in config.items():\n        value, present = payload, True\n        for segment in path:\n            if isinstance(value, list) and type(segment) is int and 0 <= segment < len(value):\n                value = value[segment]\n            elif isinstance(value, dict) and segment in value:\n                value = value[segment]\n            else:\n                present = False\n                break\n        if not present: continue\n        field = facts[\"fields\"][key]\n        field.update(present=True, kind=kind(value), text=value if isinstance(value,str) else \"\", isTrue=value is True, isFalse=value is False, truthy=bool(value))\n        if not isinstance(value, dict):\n            try: value.get(\"_inspection\")\n            except Exception as exc: field[\"objectGetError\"] = str(exc)\n        try: field[\"pythonText\"] = str(value)\n        except Exception as exc: field[\"pythonTextError\"] = str(exc)\n        field[\"json\"], field[\"serializeError\"] = serialized(value, False)\n        field[\"asciiJson\"], _ = serialized(value, True)\nexcept Exception as exc:\n    facts[\"error\"] = str(exc)\n    facts[\"errorType\"] = type(exc).__name__\nfactsJson = json.dumps(facts, separators=(\",\", \":\"), ensure_ascii=False)\n",
          "script_arguments": [
